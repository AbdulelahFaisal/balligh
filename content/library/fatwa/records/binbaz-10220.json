   {
    "kind": "strong",
    "text": "الجواب:"
   }
  ],
  [
   {
    "kind": "text",
    "text": "نعم صومه صحيح، ولو ما تسحر، الحمد لله، نعم، العمدة على النية، فالأعمال بالنيات، الحمد لله، نعم. "
   }
  ]
 ],
 "content_sha256": "sha256:dce4f55a155bb5c4f05e91a806ba7417d619591a0752fd30b31ae33a29daf7a8",
 "id": "binbaz-10220",
 "language": "ar",
 "notes": [],
 "question": [
  [
   {
    "kind": "strong",
    "text": "السؤال:"
   }
  ],
  [
   {
    "kind": "text",
    "text": "من استيقظ قبل شروق الشمس، وهو ينوي الصيام، فهل صيامه صحيح؟"
   }
  ]
 ],
