 "notes": [],
 "question": [
  [
   {
    "kind": "strong",
    "text": "السؤال:"
   }
  ],
  [
   {
    "kind": "text",
    "text": "من نسي أن يسمي قبل الوضوء؟"
   }
  ]
 ],
