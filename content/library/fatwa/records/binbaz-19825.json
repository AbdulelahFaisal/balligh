 "notes": [
  {
   "id": "1",
   "runs": [
    {
     "kind": "text",
     "text": "أخرجه البخاري في (فضائل القرآن)، برقم: 4639، باب (خيركم من تعلم القرآن وعلمه)."
    }
   ]
  },
  {
   "id": "2",
   "runs": [
    {
     "kind": "text",
     "text": "رواه مسلم في (صلاة المسافرين وقصرها)، برقم: 1329، وابن ماجه في (الآداب)، برقم: 3769. "
    }
   ]
  },
  {
   "id": "3",
   "runs": [
    {
     "kind": "text",
     "text": "نشر في (مجلة الدعوة)، العدد رقم: 1520، في 15/7/1416هـ. (مجموع فتاوى ومقالات الشيخ ابن باز 24/ 357)."
    }
   ]
  }
 ],
 "question": [
  [
   {
    "kind": "strong",
    "text": "السؤال:"
   }
  ],
  [
   {
    "kind": "text",
    "text": "لي قريب يحب قراءة القرآن الكريم، غير أنه لا يجيد قواعد اللغة العربية والتلاوة، فماذا يفعل؟"
   }
  ]
 ],
