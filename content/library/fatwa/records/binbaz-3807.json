   {
    "kind": "strong",
    "text": "ج:"
   },
   {
    "kind": "text",
    "text": " يجزئ ذلك إذا نوى الطهارتين، والأفضل أن يتوضأ أولا ثم يغتسل، كما هو فعل النبي ﷺ؛ لأنه أكمل، ولا حرج من استعمال الصابون والشامبو والسدر، ونحو ذلك مما يزال به الأوساخ."
   }
  ],
  [
   {
    "kind": "text",
    "text": "وفق الله الجميع"
   },
   {
    "kind": "noteref",
    "note": "1",
    "text": "[1]"
   },
   {
    "kind": "text",
    "text": "."
   }
  ]
 ],
