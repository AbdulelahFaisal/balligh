{
 "answer": [
  [
   {
    "kind": "strong",
    "text": "الجواب:"
   }
  ],
  [
   {
    "kind": "text",
    "text": "لا بأس مر النبي ﷺ على نساء، وسلم عليهن، مر على جماعة من النساء، وسلم عليهن، عليه الصلاة والسلام."
   }
  ]
 ],
 "content_sha256": "sha256:9edb5da12796e3f59e9274f61fc0bd1428b1b9045d7ab8bb2acc72b82e787731",
 "id": "binbaz-1313",
 "language": "ar",
 "notes": [],
 "question": [
  [
   {
    "kind": "strong",
    "text": "السؤال:"
   }
  ],
  [
   {
    "kind": "text",
    "text": "لو مر واحد على امرأة ما يعرفها، يرد عليها السلام؟"
   }
  ]
 ],
