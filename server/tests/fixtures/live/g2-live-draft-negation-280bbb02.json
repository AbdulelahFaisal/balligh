      "kind": "quote",
      "source_span_ids": [
        "s1"
      ],
      "text": "A shared file is not published without the name of its author.",
      "quote_id": "s1",
      "derivation": "machine_translation",
      "editor_note": ""
    },
    {
      "id": "c2",
      "kind": "quote",
      "source_span_ids": [
        "s2"
      ],
      "text": "It is not enough to mention the name in a separate message. The name must be written in the file itself.",
      "quote_id": "s2",
      "derivation": "machine_translation",
      "editor_note": ""
    },
    {
      "id": "c3",
      "kind": "explanation",
      "source_span_ids": [
        "s3"
      ],
      "text": "If you do not know the author's name, do not say who wrote the file. Do not guess a name.",
      "quote_id": "s3",
      "derivation": "machine_explanation",
      "editor_note": ""
    }
