9cd\u09b0\u09b9\u09a3 \u0995\u09b0\u09cb\u0964 \u0986\u09b0 \u0986\u09ae\u09bf \u09a4\u09cb \u0995\u09c7\u09ac\u09b2 \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0 (\u09b6\u09be\u09b8\u09cd\u09a4\u09bf\u09b0 \u0993\u09aa\u09b0) \u09b6\u09be\u09b8\u09cd\u09a4\u09bf\u0987 \u09ac\u09c3\u09a6\u09cd\u09a7\u09bf \u0995\u09b0\u09ac\u09cb\u0964","footnotes":""},{"id":"5703","sura":"78","aya":"31","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0644\u0650\u0644\u06e1\u0645\u064f\u062a\u0651\u064e\u0642\u0650\u064a\u0646\u064e \u0645\u064e\u0641\u064e\u0627\u0632\u064b\u0627","translation":"\u09a8\u09bf\u09b6\u09cd\u099a\u09df \u09ae\u09c1\u09a4\u09cd\u09a4\u09be\u0995\u09c0\u09a6\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09b0\u09df\u09c7\u099b\u09c7 \u09b8\u09ab\u09b2\u09a4\u09be (\u099c\u09be\u09a8\u09cd\u09a8\u09be\u09a4)\u0964","footnotes":""},{"id":"5704","sura":"78","aya":"32","arabic_text":"\u062d\u064e\u062f\u064e\u0627\u0653\u0626\u0650\u0642\u064e \u0648\u064e\u0623\u064e\u0639\u06e1\u0646\u064e\u0670\u0628\u0657\u0627","translation":"\u0989\u09a6\u09cd\u09af\u09be\u09a8\u09b8\u09ae\u09c2\u09b9 \u0993 \u0986\u0999\u09cd\u0997\u09c1\u09b0\u09b8\u09ae\u09c2\u09b9\u0964","footnotes":""},{"id":"5705","sura":"78","aya":"33","arabic_text":"\u0648\u064e\u0643\u064e\u0648\u064e\u0627\u0639\u0650\u0628\u064e \u0623\u064e\u062a\u06e1\u0631\u064e\u0627\u0628\u0657\u0627","translation":"\u0986\u09b0 \u09b8\u09ae\u09ac\u09df\u09b8\u09cd\u0995\u09be \u0989\u09a0\u09a8\u09cd\u09a4 \u09af\u09cc\u09ac\u09a8\u09be \u09a4\u09b0\u09c1\u09a3\u09c0\u0964","footnotes":""},{"id":"5706","sura":"78","aya":"34","arabic_text":"\u0648\u064e\u0643\u064e\u0623\u06e1\u0633\u0657\u0627 \u062f\u0650\u0647\u064e\u0627\u0642\u0657\u0627","translation":"\u0986\u09b0 \u09aa\u09b0\u09bf\u09aa\u09c2\u09b0\u09cd\u09a3 \u09aa\u09be\u09a8\u09aa\u09be\u09a4\u09cd\u09b0\u0964","footnotes":""},{"id":"5707","sura":"78","aya":"35","arabic_text":"\u0644\u0651\u064e\u0627 \u064a\u064e\u0633\u06e1\u0645\u064e\u0639\u064f\u0648\u0646\u064e \u0641\u0650\u064a\u0647\u064e\u0627 \u0644\u064e\u063a\u06e1\u0648\u0657\u0627 \u0648\u064e\u0644\u064e\u0627 \u0643\u0650\u0630\u0651\u064e\u0670\u0628\u0657\u0627","translation":"\u09a4\u09be\u09b0\u09be \u09b8\u09c7\u0996\u09be\u09a8\u09c7 \u0995\u09cb\u09a8 \u0985\u09b8\u09be\u09b0 \u0993 \u09ae\u09bf\u09a5\u09cd\u09af\u09be \u0995\u09a5\u09be \u09b6\u09c1\u09a8\u09ac\u09c7 \u09a8\u09be\u0964","footnotes":""},{"id":"5708","sura":"78","aya":"36","arabic_text":"\u062c\u064e\u0632\u064e\u0627\u0653\u0621\u0657 \u0645\u0651\u0650\u0646 \u0631\u0651\u064e\u0628\u0651\u0650\u0643\u064e \u0639\u064e\u0637\u064e\u0627\u0653\u0621\u064b \u062d\u0650\u0633\u064e\u0627\u0628\u0657\u0627","translation":"\u09a4\u09cb\u09ae\u09be\u09b0 \u09b0\u09ac\u09c7\u09b0 \u09aa\u0995\u09cd\u09b7 \u09a5\u09c7\u0995\u09c7 \u09aa\u09cd\u09b0\u09a4\u09bf\u09ab\u09b2, \u09af\u09a5\u09cb\u099a\u09bf\u09a4 \u09a6\u09be\u09a8\u09b8\u09cd\u09ac\u09b0\u09c2\u09aa\u0964","footnotes":""},{"id":"5709","sura":"78","aya":"37","arabic_text":"\u0631\u0651\u064e\u0628\u0651\u0650 \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0670\u0648\u064e\u0670\u062a\u0650 \u0648\u064e\u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650 \u0648\u064e\u0645\u064e\u0627 \u0628\u064e\u064a\u06e1\u0646\u064e\u0647\u064f\u0645\u064e\u0627 \u0671\u0644\u0631\u0651\u064e\u062d\u06e1\u0645\u064e\u0670\u0646\u0650\u06d6 \u0644\u064e\u0627 \u064a\u064e\u0645\u06e1\u0644\u0650\u0643\u064f\u0648\u0646\u064e \u0645\u0650\u0646\u06e1\u0647\u064f \u062e\u0650\u0637\u064e\u0627\u0628\u0657\u0627","translation":"\u09af\u09bf\u09a8\u09bf \u0986\u09b8\u09ae\u09be\u09a8\u09b8\u09ae\u09c2\u09b9, \u099c\u09ae\u09bf\u09a8 \u0993 \u098f\u09a4\u09a6\u09c1\u09ad\u09df\u09c7\u09b0 \u09ae\u09a7\u09cd\u09af\u09ac\u09b0\u09cd\u09a4\u09c0 \u09b8\u09ac\u0995\u09bf\u099b\u09c1\u09b0 \u09b0\u09ac, \u09aa\u09b0\u09ae \u0995\u09b0\u09c1\u09a3\u09be\u09ae\u09df\u0964 \u09a4\u09be\u09b0\u09be \u09a4\u09be\u0981\u09b0 \u09b8\u09be\u09ae\u09a8\u09c7 \u0995\u09a5\u09be \u09ac\u09b2\u09be\u09b0 \u09b8\u09be\u09ae\u09b0\u09cd\u09a5\u09cd\u09af \u09b0\u09be\u0996\u09ac\u09c7 \u09a8\u09be\u0964","footnotes":""},{"id":"5710","sura":"78","aya":"38","arabic_text":"\u064a\u064e\u0648\u06e1\u0645\u064e \u064a\u064e\u0642\u064f\u0648\u0645\u064f \u0671\u0644\u0631\u0651\u064f\u0648\u062d\u064f \u0648\u064e\u0671\u0644\u06e1\u0645\u064e\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e\u0629\u064f \u0635\u064e\u0641\u0651\u0657\u0627\u06d6 \u0644\u0651\u064e\u0627 \u064a\u064e\u062a\u064e\u0643\u064e\u0644\u0651\u064e\u0645\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0645\u064e\u0646\u06e1 \u0623\u064e\u0630\u0650\u0646\u064e \u0644\u064e\u0647\u064f \u0671\u0644\u0631\u0651\u064e\u062d\u06e1\u0645\u064e\u0670\u0646\u064f \u0648\u064e\u0642\u064e\u0627\u0644\u064e \u0635\u064e\u0648\u064e\u0627\u0628\u0657\u0627","translation":"\u09b8\u09c7\u09a6\u09bf\u09a8 \u09b0\u09c2\u09b9 (\u099c\u09bf\u09ac\u09b0\u09c0\u09b2) \u0993 \u09ab\u09bf\u09b0\u09bf\u09b6\u09a4\u09be\u0997\u09a3 \u09b8\u09be\u09b0\u09bf\u09ac\u09a6\u09cd\u09a7\u09ad\u09be\u09ac\u09c7 \u09a6\u09be\u0981\u09dc\u09be\u09ac\u09c7, \u09af\u09be\u0995\u09c7 \u09aa\u09b0\u09ae \u0995\u09b0\u09c1\u09a3\u09be\u09ae\u09df \u0985\u09a8\u09c1\u09ae\u09a4\u09bf \u09a6\u09bf\u09ac\u09c7\u09a8 \u09b8\u09c7 \u099b\u09be\u09dc\u09be \u0985\u09a8\u09cd\u09af\u09b0\u09be \u0995\u09cb\u09a8 \u0995\u09a5\u09be \u09ac\u09b2\u09ac\u09c7 \u09a8\u09be\u0964 \u0986\u09b0 \u09b8\u09c7 \u09b8\u09a0\u09bf\u0995 \u0995\u09a5\u09be\u0987 \u09ac\u09b2\u09ac\u09c7\u0964","footnotes":"(\u09e7) \u0985\u09b0\u09cd\u09a5\u09be\u09ce \u09b8\u09c1\u09aa\u09be\u09b0\u09bf\u09b6 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09ac\u09c7 \u09a8\u09be\u0964"},{"id":"5711","sura":"78","aya":"39","arabic_text":"\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0671\u0644\u06e1\u064a\u064e\u0648\u06e1\u0645\u064f \u0671\u0644\u06e1\u062d\u064e\u0642\u0651\u064f\u06d6 \u0641\u064e\u0645\u064e\u0646 \u0634\u064e\u0627\u0653\u0621\u064e \u0671\u062a\u0651\u064e\u062e\u064e\u0630\u064e \u0625\u0650\u0644\u064e\u0649\u0670 \u0631\u064e\u0628\u0651\u0650\u0647\u0650\u06e6 \u0645\u064e\u0640\u0654\u064e\u0627\u0628\u064b\u0627","translation":"\u0990 \u09a6\u09bf\u09a8\u099f\u09bf \u09b8\u09a4\u09cd\u09af\u0964 \u0985\u09a4\u098f\u09ac, \u09af\u09c7 (\u09ae\u09c1\u0995\u09cd\u09a4\u09bf \u09b2\u09be\u09ad \u0995\u09b0\u09a4\u09c7) \u099a\u09be\u09df, \u09b8\u09c7 \u09a4\u09be\u09b0 \u09b0\u09ac\u09c7\u09b0 \u09a8\u09bf\u0995\u099f \u0986\u09b6\u09cd\u09b0\u09df \u0997\u09cd\u09b0\u09b9\u09a3 \u0995\u09b0\u09c1\u0995\u0964","footnotes":""},{"id":"5712","sura":"78","aya":"40","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0627\u0653 \u0623\u064e\u0646\u0630\u064e\u0631\u06e1\u0646\u064e\u0670\u0643\u064f\u0645\u06e1 \u0639\u064e\u0630\u064e\u0627\u0628\u0657\u0627 \u0642\u064e\u0631\u0650\u064a\u0628\u0657\u0627 \u064a\u064e\u0648\u06e1\u0645\u064e \u064a\u064e\u0646\u0638\u064f\u0631\u064f \u0671\u0644\u06e1\u0645\u064e\u0631\u06e1\u0621\u064f \u0645\u064e\u0627 \u0642\u064e\u062f\u0651\u064e\u0645\u064e\u062a\u06e1 \u064a\u064e\u062f\u064e\u0627\u0647\u064f \u0648\u064e\u064a\u064e\u0642\u064f\u0648\u0644\u064f \u0671\u0644\u06e1\u0643\u064e\u0627\u0641\u0650\u0631\u064f \u064a\u064e\u0670\u0644\u064e\u064a\u06e1\u062a\u064e\u0646\u0650\u064a \u0643\u064f\u0646\u062a\u064f \u062a\u064f\u0631\u064e\u0670\u0628\u064e\u06e2\u0627","translation":"\u09a8\u09bf\u09b6\u09cd\u099a\u09df \u0986\u09ae\u09bf \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u098f\u0995\u099f\u09bf \u09a8\u09bf\u0995\u099f\u09ac\u09b0\u09cd\u09a4\u09c0 \u09b6\u09be\u09b8\u09cd\u09a4\u09bf \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09c7 \u09b8\u09a4\u09b0\u09cd\u0995 \u0995\u09b0\u09b2\u09be\u09ae\u0964 \u09af\u09c7\u09a6\u09bf\u09a8 \u09ae\u09be\u09a8\u09c1\u09b7 \u09a6\u09c7\u0996\u09a4\u09c7 \u09aa\u09be\u09ac\u09c7, \u09a4\u09be\u09b0 \u09a6\u09c1\u2019\u09b9\u09be\u09a4 \u0995\u09c0 (\u0986\u09ae\u09b2\u09a8\u09be\u09ae\u09be) \u0985\u0997\u09cd\u09b0\u09c7 \u09aa\u09cd\u09b0\u09c7\u09b0\u09a3 \u0995\u09b0\u09c7\u099b\u09c7 \u098f\u09ac\u0982 \u0995\u09be\u09ab\u09bf\u09b0 (\u0986\u09ab\u09b8\u09cb\u09b8 \u0995\u09b0\u09c7) \u09ac\u09b2\u09ac\u09c7: \u2018\u09b9\u09be\u09df, \u0986\u09ae\u09bf \u09af\u09a6\u09bf \u09ae\u09be\u099f\u09bf \u09b9\u09a4\u09be\u09ae!\u2019","footnotes":""}]}