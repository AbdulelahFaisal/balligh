46 \u0646\u0651\u064e\u0632\u0650\u064a\u062f\u064e\u0643\u064f\u0645\u06e1 \u0625\u0650\u0644\u0651\u064e\u0627 \u0639\u064e\u0630\u064e\u0627\u0628\u064b\u0627","translation":"\u00ab Go\u00fbtez le ch\u00e2timent ! Nous ne ferons qu\u2019accro\u00eetre votre supplice ! \u00bb","footnotes":""},{"id":"5703","sura":"78","aya":"31","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0644\u0650\u0644\u06e1\u0645\u064f\u062a\u0651\u064e\u0642\u0650\u064a\u0646\u064e \u0645\u064e\u0641\u064e\u0627\u0632\u064b\u0627","translation":"Les pieux croyants, pour leur part, jouiront de tous les d\u00e9lices :","footnotes":""},{"id":"5704","sura":"78","aya":"32","arabic_text":"\u062d\u064e\u062f\u064e\u0627\u0653\u0626\u0650\u0642\u064e \u0648\u064e\u0623\u064e\u0639\u06e1\u0646\u064e\u0670\u0628\u0657\u0627","translation":"vergers luxuriants et vignes,","footnotes":""},{"id":"5705","sura":"78","aya":"33","arabic_text":"\u0648\u064e\u0643\u064e\u0648\u064e\u0627\u0639\u0650\u0628\u064e \u0623\u064e\u062a\u06e1\u0631\u064e\u0627\u0628\u0657\u0627","translation":"jeunes filles d\u2019\u00e9gale jeunesse,","footnotes":""},{"id":"5706","sura":"78","aya":"34","arabic_text":"\u0648\u064e\u0643\u064e\u0623\u06e1\u0633\u0657\u0627 \u062f\u0650\u0647\u064e\u0627\u0642\u0657\u0627","translation":"coupes remplies de vin \u00e0 volont\u00e9.","footnotes":""},{"id":"5707","sura":"78","aya":"35","arabic_text":"\u0644\u0651\u064e\u0627 \u064a\u064e\u0633\u06e1\u0645\u064e\u0639\u064f\u0648\u0646\u064e \u0641\u0650\u064a\u0647\u064e\u0627 \u0644\u064e\u063a\u06e1\u0648\u0657\u0627 \u0648\u064e\u0644\u064e\u0627 \u0643\u0650\u0630\u0651\u064e\u0670\u0628\u0657\u0627","translation":"L\u00e0, ils n\u2019entendront ni futilit\u00e9s, ni propos mensongers.","footnotes":""},{"id":"5708","sura":"78","aya":"36","arabic_text":"\u062c\u064e\u0632\u064e\u0627\u0653\u0621\u0657 \u0645\u0651\u0650\u0646 \u0631\u0651\u064e\u0628\u0651\u0650\u0643\u064e \u0639\u064e\u0637\u064e\u0627\u0653\u0621\u064b \u062d\u0650\u0633\u064e\u0627\u0628\u0657\u0627","translation":"R\u00e9compense plus que suffisante accord\u00e9e par ton Seigneur,","footnotes":""},{"id":"5709","sura":"78","aya":"37","arabic_text":"\u0631\u0651\u064e\u0628\u0651\u0650 \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0670\u0648\u064e\u0670\u062a\u0650 \u0648\u064e\u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650 \u0648\u064e\u0645\u064e\u0627 \u0628\u064e\u064a\u06e1\u0646\u064e\u0647\u064f\u0645\u064e\u0627 \u0671\u0644\u0631\u0651\u064e\u062d\u06e1\u0645\u064e\u0670\u0646\u0650\u06d6 \u0644\u064e\u0627 \u064a\u064e\u0645\u06e1\u0644\u0650\u0643\u064f\u0648\u0646\u064e \u0645\u0650\u0646\u06e1\u0647\u064f \u062e\u0650\u0637\u064e\u0627\u0628\u0657\u0627","translation":"Seigneur des cieux, de la terre et de ce qui se trouve entre eux, le Tout Mis\u00e9ricordieux, auquel nul n\u2019osera s\u2019adresser.","footnotes":""},{"id":"5710","sura":"78","aya":"38","arabic_text":"\u064a\u064e\u0648\u06e1\u0645\u064e \u064a\u064e\u0642\u064f\u0648\u0645\u064f \u0671\u0644\u0631\u0651\u064f\u0648\u062d\u064f \u0648\u064e\u0671\u0644\u06e1\u0645\u064e\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e\u0629\u064f \u0635\u064e\u0641\u0651\u0657\u0627\u06d6 \u0644\u0651\u064e\u0627 \u064a\u064e\u062a\u064e\u0643\u064e\u0644\u0651\u064e\u0645\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0645\u064e\u0646\u06e1 \u0623\u064e\u0630\u0650\u0646\u064e \u0644\u064e\u0647\u064f \u0671\u0644\u0631\u0651\u064e\u062d\u06e1\u0645\u064e\u0670\u0646\u064f \u0648\u064e\u0642\u064e\u0627\u0644\u064e \u0635\u064e\u0648\u064e\u0627\u0628\u0657\u0627","translation":"Ce Jour-l\u00e0, l\u2019Esprit[7] et les anges se tiendront en rangs et nul ne pourra prendre la parole[8] sauf celui qui en aura \u00e9t\u00e9 autoris\u00e9 par le Tout Mis\u00e9ricordieux et qui ne prononcera que des paroles de v\u00e9rit\u00e9.","footnotes":"[7] L\u2019ange Gabriel, selon la majorit\u00e9 des commentateurs.\n[8] Pour interc\u00e9der, expliquent nombre d\u2019ex\u00e9g\u00e8tes."},{"id":"5711","sura":"78","aya":"39","arabic_text":"\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0671\u0644\u06e1\u064a\u064e\u0648\u06e1\u0645\u064f \u0671\u0644\u06e1\u062d\u064e\u0642\u0651\u064f\u06d6 \u0641\u064e\u0645\u064e\u0646 \u0634\u064e\u0627\u0653\u0621\u064e \u0671\u062a\u0651\u064e\u062e\u064e\u0630\u064e \u0625\u0650\u0644\u064e\u0649\u0670 \u0631\u064e\u0628\u0651\u0650\u0647\u0650\u06e6 \u0645\u064e\u0640\u0654\u064e\u0627\u0628\u064b\u0627","translation":"Ce Jour arrivera in\u00e9luctablement ! Que celui qui le d\u00e9sire revienne donc \u00e0 son Seigneur.","footnotes":""},{"id":"5712","sura":"78","aya":"40","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0627\u0653 \u0623\u064e\u0646\u0630\u064e\u0631\u06e1\u0646\u064e\u0670\u0643\u064f\u0645\u06e1 \u0639\u064e\u0630\u064e\u0627\u0628\u0657\u0627 \u0642\u064e\u0631\u0650\u064a\u0628\u0657\u0627 \u064a\u064e\u0648\u06e1\u0645\u064e \u064a\u064e\u0646\u0638\u064f\u0631\u064f \u0671\u0644\u06e1\u0645\u064e\u0631\u06e1\u0621\u064f \u0645\u064e\u0627 \u0642\u064e\u062f\u0651\u064e\u0645\u064e\u062a\u06e1 \u064a\u064e\u062f\u064e\u0627\u0647\u064f \u0648\u064e\u064a\u064e\u0642\u064f\u0648\u0644\u064f \u0671\u0644\u06e1\u0643\u064e\u0627\u0641\u0650\u0631\u064f \u064a\u064e\u0670\u0644\u064e\u064a\u06e1\u062a\u064e\u0646\u0650\u064a \u0643\u064f\u0646\u062a\u064f \u062a\u064f\u0631\u064e\u0670\u0628\u064e\u06e2\u0627","translation":"Nous vous avons mis en garde contre un ch\u00e2timent imminent, le Jour o\u00f9 l\u2019homme verra ses \u0153uvres et o\u00f9 le m\u00e9cr\u00e9ant s\u2019exclamera : \u00ab Si seulement je n\u2019\u00e9tais que poussi\u00e8re ! \u00bb","footnotes":""}]}